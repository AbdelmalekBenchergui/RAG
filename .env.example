# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Use locally cached Hugging Face models only (no network revalidation)
HF_HUB_OFFLINE=1

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Vector DB
COLLECTION_NAME=rag_collection
QDRANT_URL=http://localhost:6333

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
#SPARSE_MODEL=naver/splade-cocondenser-selfdistil
#HYBRID_SEARCH_ENABLED=true

# Reranking (cross-encoder)
#RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# Retrieval confidence (sigmoid scores)
#RETRIEVAL_MIN_SCORE=0.1

# Graph DB
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM (local via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1

# Evaluation (LLM-as-a-judge)
#JUDGE_MODEL=          # defaults to LLM_MODEL; set a different model to avoid self-bias
EVAL_JUDGE_PASSES=2

# Knowledge Graph extraction
#KG_EXTRACTION_ENABLED=true
KG_BATCH_SIZE=5
KG_MAX_CONCURRENCY=4
#KG_MAX_CHUNKS=200

# Graph retrieval expansion
#GRAPH_EXPANSION_ENABLED=true
GRAPH_MAX_HOPS=1
GRAPH_EXPANSION_MAX_ENTITIES=5
